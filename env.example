# --- Discord ---------------------------------------------------------------
# Token du bot (Developer Portal > Bot > Reset Token). Ne jamais le partager.
DISCORD_TOKEN=
# Identifiants (clic droit > Copier l'identifiant, avec le mode développeur activé)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Ton identifiant utilisateur Discord (plusieurs possibles, séparés par des virgules)
DISCORD_ADMIN_IDS=
# Mention ajoutée aux alertes : vide, @here, @everyone ou <@TON_ID_UTILISATEUR>
ALERT_MENTION=

# --- Prometheus ------------------------------------------------------------
# Si le réseau monitoring_default n'existe pas, mets http://ip-docker:9090
PROMETHEUS_URL=http://prometheus:9090

# --- Proxmox (uniquement pour /action) -------------------------------------
PVE_URL=https://ip-proxmox:8006
PVE_NODE=pve
PVE_VERIFY_SSL=false
PVE_TOKEN_ID=discordbot@pve!bot
PVE_TOKEN_SECRET=
# Invités que /action peut piloter (jamais celui qui héberge le bot)
ALLOWED_GUESTS=

# --- Rapport et alertes ----------------------------------------------------
TZ=Europe/Paris
REPORT_HOUR=9
ALERT_CPU=90
ALERT_RAM=90
ALERT_DISK=80
ALERT_TEMP=85
# Nombre de vérifications consécutives (1 par minute) avant d'alerter
ALERT_CONSECUTIVE_CHECKS=3
# Délai avant de répéter une alerte qui persiste
ALERT_COOLDOWN_MIN=60
